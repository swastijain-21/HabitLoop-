# Copy to backend/.env (gitignored) OR set these in your OS / IDE run config.
# Never commit real passwords. Never put these in the frontend.

DB_URL=jdbc:mysql://YOUR_HOST:3306/habitloop?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=YOUR_USERNAME
DB_PASSWORD=YOUR_PASSWORD

# Local-only example (if using MySQL on this machine):
# DB_URL=jdbc:mysql://localhost:3306/habitloop?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# DB_USERNAME=root
# DB_PASSWORD=your_local_password
