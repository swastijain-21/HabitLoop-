# ==============================================================================
# Habitloop - .gitignore
# Stack: React + Vite (Frontend) | Java + Spring Boot (Backend) | MySQL (Database)
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend (React + Vite / Node.js)
# ------------------------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# Environment variables & local configuration
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# Frontend debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# Backend (Java + Spring Boot / Maven / Gradle)
# ------------------------------------------------------------------------------
# Maven build output
backend/target/
target/
*.class

# Gradle build output (if using Gradle)
backend/build/
build/
.gradle/

# Log files
*.log
logs/

# Package files (ignore generated JAR/WAR archives)
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# But keep Maven/Gradle wrappers if present in the future
!**/wrapper/maven-wrapper.jar
!**/gradle-wrapper.jar

# ------------------------------------------------------------------------------
# Database (MySQL & Local Dumps)
# ------------------------------------------------------------------------------
# Ignore database backup dumps, SQL exports, and local data volumes
*.dump
*.sql.gz
mysql-data/
*.sqlite
*.db

# ------------------------------------------------------------------------------
# IDEs and Editors
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbproject/load-impl.xml

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
